{
  "name": "resume-score-by-scorelab",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "benchmark": "node benchmark/run-benchmark.mjs",
    "benchmark:quality": "node benchmark/report-writer-quality.mjs",
    "test:nexx-core": "node --experimental-strip-types --test tests/nexx-core-phase1.test.ts",
    "test:nexx-core-payment-facts": "node --experimental-strip-types --test tests/nexx-core-payment-facts.test.ts",
    "test:nexx-core-shadow": "node --experimental-strip-types --test tests/nexx-core-shadow-adapter.test.ts",
    "test:nexx-core-preview-staging": "node --experimental-strip-types --test tests/nexx-core-preview-staging-config.test.ts",
    "test:nexx-core-shadow-quality": "node --experimental-strip-types --test tests/nexx-core-shadow-quality.test.ts",
    "test:nexx-core-phase2": "node --experimental-strip-types --test tests/nexx-core-phase2-event-metadata.test.ts tests/nexx-core-phase2-journeys.test.ts tests/nexx-core-shadow-adapter.test.ts",
    "nexx-core:migrate:dev": "node --env-file=.env.local --experimental-strip-types scripts/nexx-core-migrate-dev.ts",
    "nexx-core:migrate:staging": "node --env-file=.env.staging.local --experimental-strip-types scripts/nexx-core-migrate-dev.ts",
    "nexx-core:restore-test:dev": "node --env-file=.env.local --experimental-strip-types scripts/nexx-core-restore-test-dev.ts",
    "nexx-core:restore-test:staging": "node --env-file=.env.staging.local --experimental-strip-types scripts/nexx-core-restore-test-dev.ts",
    "nexx-core:ingest:dev": "node --env-file=.env.local --experimental-strip-types scripts/nexx-core-dev-ingest-server.ts",
    "nexx-core:ingest:staging": "node --env-file=.env.staging.local --experimental-strip-types scripts/nexx-core-dev-ingest-server.ts",
    "nexx-core:verify-ingest:dev": "node --env-file=.env.local --experimental-strip-types scripts/nexx-core-verify-dev-ingestion.ts",
    "nexx-core:verify-payment-facts:dev": "node --env-file=.env.local --experimental-strip-types scripts/nexx-core-verify-payment-facts-dev.ts",
    "nexx-core:verify-shadow:dev": "node --env-file=.env.local --experimental-strip-types scripts/nexx-core-verify-shadow-adapter-dev.ts",
    "nexx-core:verify-shadow:staging": "node --env-file=.env.staging.local --experimental-strip-types scripts/nexx-core-verify-shadow-adapter-dev.ts",
    "test:nexx-core-replication": "node --experimental-strip-types --test tests/nexx-core-local-replication.test.ts",
    "nexx-core:seed-replication-fixture:dev": "node --env-file=.env.local --experimental-strip-types scripts/nexx-core-seed-synthetic-replication-dev.ts",
    "nexx-core:replicate:local": "zsh scripts/nexx-core-local-replication-runner.zsh replicate",
    "nexx-core:replicate:staging": "NEXX_CORE_LOCAL_REPLICATION_TARGET=staging zsh scripts/nexx-core-local-replication-runner.zsh replicate",
    "nexx-core:replica:query": "zsh scripts/nexx-core-local-replication-runner.zsh query",
    "nexx-core:validate-shadow-quality:dev": "zsh scripts/nexx-core-local-replication-runner.zsh validate-shadow-quality",
    "nexx-core:validate-shadow-quality:staging": "NEXX_CORE_LOCAL_REPLICATION_TARGET=staging zsh scripts/nexx-core-local-replication-runner.zsh validate-shadow-quality",
    "nexx-core:replica:schedule:install": "node --env-file=.env.local --experimental-strip-types scripts/nexx-core-install-local-replication-schedule.ts",
    "start": "next start",
    "lint": "ESLINT_USE_FLAT_CONFIG=false eslint . --ext .js,.jsx,.ts,.tsx",
    "typecheck": "tsc --noEmit",
    "test:plans": "node --experimental-strip-types --test tests/report-plan.test.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@polar-sh/nextjs": "^0.9.6",
    "@polar-sh/sdk": "^0.49.0",
    "next": "^15.1.6",
    "openai": "^4.80.1",
    "pdf-parse": "^1.1.1",
    "postgres": "^3.4.9",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "undici": "^8.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.18.0",
    "eslint-config-next": "^15.1.6",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3"
  }
}

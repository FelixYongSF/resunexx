OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional local proxy for networks where Node.js cannot reach api.openai.com directly.
# Example: HTTPS_PROXY=http://127.0.0.1:7890
HTTPS_PROXY=
HTTP_PROXY=
ALL_PROXY=

# Polar credentials remain server-side. Product IDs map the $4.99 Standard and
# $9.99 Full report plans to their Polar products.
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_ENVIRONMENT=production
POLAR_STANDARD_PRODUCT_ID=73bf4f74-27df-477c-ad25-e14dbd238e70
POLAR_FULL_PRODUCT_ID=37e6e212-82af-4021-ac34-efd03c3d2e13

NEXT_PUBLIC_APP_URL=https://resunexx.com

# Public search-index notification key. It is intentionally served at
# /indexnow-key.txt so participating search engines can verify site ownership.
INDEXNOW_KEY=
# Use a long random secret. Vercel Cron sends this as a Bearer token when set as
# CRON_SECRET; INDEXNOW_CRON_SECRET is supported for non-Vercel schedulers.
INDEXNOW_CRON_SECRET=

# Required for report persistence in local and production environments.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Retention windows for encrypted Redis report records. Defaults are 1 hour while
# processing, 1 day for free previews, and 30 days for paid reports.
REPORT_PROCESSING_TTL_SECONDS=3600
REPORT_FREE_TTL_SECONDS=86400
REPORT_PAID_TTL_SECONDS=2592000

# Vercel Marketplace may inject these standard Upstash names instead.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Nexx Core defaults to local development. Production uses a separate, dedicated
# Neon database and the exact production values listed below. Never place real
# values in Git or a client-visible NEXT_PUBLIC_ variable.
NEXX_CORE_ENABLED=false
NEXX_CORE_ENVIRONMENT=development
NEXX_CORE_CONTRACT_VERSION=nexx-core-event-v1
NEXX_CORE_PRIVACY_POLICY_VERSION=2026-07-01
NEXX_CORE_PRODUCT_KEY=resunexx
NEXX_CORE_DATABASE_URL=
# Staging must use a separate Neon branch/database URL. Keep it only in the
# ignored .env.staging.local file; never add it to Vercel Production.
NEXX_CORE_STAGING_DATABASE_URL=
NEXX_CORE_MIGRATION_TARGET=development
NEXX_CORE_INGEST_TARGET=development
NEXX_CORE_SERVER_TOKEN=
NEXX_CORE_PAYMENT_FACTS_TARGET=development
NEXX_CORE_SHADOW_MODE=false
NEXX_CORE_SHADOW_TARGET=development
NEXX_CORE_INGEST_URL=http://127.0.0.1:4317/v1/events
# Gate B Preview-only transport: use `vercel-preview-self` only with
# NEXX_CORE_ENVIRONMENT=staging and VERCEL_ENV=preview. Never set in Production.

# Founder-controlled production migration and encrypted local replication are
# local-machine safety controls. They are intentionally separate from Vercel.
NEXX_CORE_PRODUCTION_MIGRATION_APPROVED=false
NEXX_CORE_LOCAL_REPLICATION_TARGET=development
NEXX_CORE_PRODUCTION_REPLICATION_APPROVED=false
NEXX_CORE_LOCAL_REPLICA_DIR=
NEXX_CORE_LOCAL_REPLICA_KEY_SCOPE=
